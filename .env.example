# LLM provider: choose one of `grok`, `xai`, `groq`
LLM_PROVIDER=grok

# Grok (xAI) configuration
GROK_API_KEY=your_xai_api_key_here
# XAI_API_KEY can be used instead of GROK_API_KEY
GROK_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# Groq configuration (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Dual-MCP workflow settings
USE_KITE=true
KITE_SSE_URL=https://mcp.kite.trade/sse
CORRELATION_PERIOD=1y
CORRELATION_INTERVAL=1d
CORRELATION_RETURNS_TYPE=simple
PORTFOLIO_REPORT_DIR=reports

# MCP server transport — "stdio" (Claude Desktop/local) or "sse" (Claude mobile/cloud)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Pluggable AI backend for trigger_portfolio_analysis tool
# "langgraph" = LangGraph + Groq autonomous workflow (default)
AI_BACKEND=langgraph
